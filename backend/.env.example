# Copy this file to .env and fill in your real values.
# These are the SAME credentials the Python app used -- same Meta
# Developer app, same token. Nothing about how you get them changes.

# IGAA-prefixed tokens (Instagram API with Instagram Login) use graph.instagram.com.
# EAA-prefixed tokens (Facebook Login for Business) use graph.facebook.com.
GRAPH_API_BASE_URL=https://graph.instagram.com/v22.0

META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=

# Server port
PORT=5000

# How often the frontend is allowed to auto-refresh (seconds). Kept in
# sync with the frontend's polling interval -- see frontend/.env.example.
AUTO_REFRESH_INTERVAL=60

# Origin the frontend dev server runs on. In production, set this to
# your deployed frontend's real origin.
CORS_ORIGIN=http://localhost:5173
